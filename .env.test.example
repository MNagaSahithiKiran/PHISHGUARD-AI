# PhishGuard AI - Automated Testing Configuration
ENVIRONMENT="test"
DEBUG=false

SECRET_KEY="test-environment-cryptographic-signing-key-minimum-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

ADMIN_DEFAULT_EMAIL="testadmin@phishguard.ai"
ADMIN_DEFAULT_PASSWORD="TestPassword2026!"

ALLOWED_HOSTS="localhost,127.0.0.1,testserver"
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

DATABASE_URL="sqlite+aiosqlite:///:memory:"
REDIS_URL="redis://localhost:6379/15"

ENABLE_SSRF_PROTECTION=true
ALLOW_PRIVATE_IPS=false
RATE_LIMIT_PER_MINUTE=1000
LOGIN_RATE_LIMIT_PER_MINUTE=1000
ENABLE_DOCS_IN_PRODUCTION=false
LOG_LEVEL="WARNING"
LOG_FORMAT="text"
