# PhishGuard AI - Development Environment Configuration
ENVIRONMENT="development"
DEBUG=true

SECRET_KEY="dev-insecure-secret-key-change-in-production-phishguard-2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

ADMIN_DEFAULT_EMAIL="admin@phishguard.ai"
ADMIN_DEFAULT_PASSWORD="Admin@PhishGuard2026!"

ALLOWED_HOSTS="localhost,127.0.0.1,testserver"
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"

DATABASE_URL="sqlite+aiosqlite:///./phishguard.db"
REDIS_URL="redis://localhost:6379/0"

ENABLE_SSRF_PROTECTION=true
ALLOW_PRIVATE_IPS=false
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=15
ENABLE_DOCS_IN_PRODUCTION=true
LOG_LEVEL="DEBUG"
LOG_FORMAT="text"
