# ==============================================================================
# PhishGuard AI - Master Environment Configuration Template
# COPY THIS FILE TO .env AND UPDATE SENSITIVE VALUES ACCORDINGLY
# ZERO REAL SECRETS STORED HERE - PLACEHOLDERS ONLY
# ==============================================================================

# Application Metadata & Runtime Environment
PROJECT_NAME="PhishGuard AI"
VERSION="2.0.0"
ENVIRONMENT="production"       # development | test | production
DEBUG=false                    # MUST be false in production

# Security & Cryptographic Tokens
SECRET_KEY=
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Network, Hosts & CORS
ALLOWED_HOSTS="localhost,127.0.0.1,.onrender.com,.vercel.app"
FRONTEND_URL="https://phishguard-ai.vercel.app"
BACKEND_CORS_ORIGINS="https://phishguard-ai.vercel.app,http://localhost:5173"
ALLOW_SQLITE_IN_PRODUCTION=false

# Database Configuration
# Production: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# Local Dev:   sqlite+aiosqlite:///./phishguard.db
DATABASE_URL=

# Background Job Queue & Cache (Redis)
# Production: redis://:<password>@<host>:<port>/0
REDIS_URL=

# External Threat Intelligence APIs (Optional; system records NOT_CONFIGURED if empty)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=

# Security Guardrails & SSRF Prevention
ENABLE_SSRF_PROTECTION=true
ALLOW_PRIVATE_IPS=false
URL_FETCH_TIMEOUT_SECONDS=10
MAX_SCAN_TIMEOUT_SECONDS=30
MAX_CONTENT_LENGTH_BYTES=10485760 # 10 MB

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="text"

# Frontend Environment
VITE_API_BASE_URL=
