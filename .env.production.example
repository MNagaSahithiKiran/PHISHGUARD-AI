# ==============================================================================
# PhishGuard AI - PRODUCTION Environment Configuration Template
# DO NOT COMMIT THE ACTUAL .env.production FILE TO VERSION CONTROL!
# Populate secrets via Docker Secrets, AWS SSM, HashiCorp Vault, or CI/CD Environment
# ==============================================================================

ENVIRONMENT="production"
DEBUG=false

# REQUIRED: Cryptographically secure random 64-char hex or base64 key
# Generate with: openssl rand -hex 32
SECRET_KEY="REPLACE_WITH_64_CHARACTER_CRYPTOGRAPHIC_SECRET_KEY_HEX"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Production Administrator
ADMIN_DEFAULT_EMAIL="soc-lead@enterprise.com"
ADMIN_DEFAULT_PASSWORD="REPLACE_WITH_STRONG_UNGUESSABLE_PASSWORD_32_CHARS"

# Explicit Host & Domain Restrictions (NO WILDCARDS in production)
ALLOWED_HOSTS="phishguard.enterprise.com,api.phishguard.enterprise.com"
BACKEND_CORS_ORIGINS="https://phishguard.enterprise.com"

# Managed PostgreSQL Database URL
DATABASE_URL="postgresql+asyncpg://phishguard_app:STRONG_DB_PASS@postgres.internal:5432/phishguard_production"

# Redis High-Availability Cluster
REDIS_URL="redis://:STRONG_REDIS_PASS@redis.internal:6379/0"

# Hardened Controls
ENABLE_SSRF_PROTECTION=true
ALLOW_PRIVATE_IPS=false
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=10
URL_FETCH_TIMEOUT_SECONDS=10
MAX_SCAN_TIMEOUT_SECONDS=30
MAX_CONTENT_LENGTH_BYTES=10485760

# Production Compliance
ENABLE_DOCS_IN_PRODUCTION=false
LOG_LEVEL="INFO"
LOG_FORMAT="json"
