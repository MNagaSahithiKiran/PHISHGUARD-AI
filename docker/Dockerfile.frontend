# ==============================================================================
# PhishGuard AI - Production Frontend Dockerfile (Multi-stage Node -> Nginx)
# ==============================================================================

# Build Stage
FROM node:20-alpine as builder

WORKDIR /build

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# Runtime Stage: High-performance minimal Nginx Alpine
FROM nginx:1.25-alpine

WORKDIR /usr/share/nginx/html

# Remove default nginx welcome page
RUN rm -rf ./*

# Copy compiled SPA static bundle from builder stage
COPY --from=builder /build/dist .

# Copy custom Nginx configuration
COPY ../docker/nginx/frontend-nginx.conf /etc/nginx/conf.d/default.conf

# Security: Set up permissions for non-root execution where supported
RUN touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid /var/cache/nginx /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=20s --timeout=5s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
